{
  "name": "zaccountant",
  "version": "0.1.0",
  "description": "Small-business accounting and payroll, reviewed by professionals.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node --test \"test/*.test.js\"",
    "test:unit": "node --test \"test/*.unit.test.js\"",
    "verify:books": "node src/db/verify-books.js",
    "db:grant": "node src/db/grant.js",
    "job:nightly": "node src/jobs/booksCheck.js",
    "drill:restore": "node src/jobs/restoreDrill.js",
    "test:load": "node src/jobs/loadTest.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^5.3.0",
    "html-to-image": "1.11.13",
    "pg": "^8.23.1",
    "qrcode-generator": "2.0.4",
    "vue": "^3.5.44"
  }
}
